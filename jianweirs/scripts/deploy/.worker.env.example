# 模板；setup-worker为每台电脑单独生成真实随机key，不使用下面的占位值。
OMAP_WORKER_API_KEY=GENERATED_LOCALLY_BY_SETUP_WORKER
OMAP_WS_URL=ws://127.0.0.1:7699
# 本机奥维第三方接口PSK；不要复制其他电脑的PSK。
OMAP_PSK=
OMAP_DEFAULT_MAP_TYPE=337
OMAP_SOURCE_MAP_TYPES_JSON={}
OMAP_OUTPUT_DIR=outputs/images
# Optional local runtime profile. Keep documented unless code0/code1 captures
# and control points established otherwise on this specific desktop runtime.
# OMAP_OPTICAL_COORDINATE_PROFILE=documented
